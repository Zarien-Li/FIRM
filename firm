#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'USAGE'
FIRM project-local helper for Claude Code.

The recommended installation path is the Claude Code plugin:
  /plugin marketplace add Zarien-Li/FIRM
  /plugin install firm@firm-research

Usage:
  firm init [PROJECT]
  firm doctor [PROJECT]
  firm list
  firm prompt new|audit

Commands:
  init     Install the 16 skills into PROJECT/.claude/skills and add a small
           research bootstrap. Existing project instructions are preserved.
  doctor   Validate a project-local installation without changing it.
  list     Print the available project-local skill commands.
  prompt   Print the optional first message for a new or existing project.
USAGE
}

absolute_project() {
  local requested="${1:-$PWD}"
  mkdir -p "${requested}"
  (
    cd "${requested}"
    pwd
  )
}

install_project_skills() {
  local project="$1"
  local backup="${project}/.firm/skill-backup-$(date +%Y%m%d-%H%M%S)"
  CLAUDE_HOME="${project}/.claude" \
    RESEARCH_SKILLS_BACKUP_DIR="${backup}" \
    bash "${ROOT_DIR}/install.sh"
}

init_project() {
  local project
  project="$(absolute_project "${1:-$PWD}")"

  mkdir -p "${project}/.firm"
  install_project_skills "${project}"

  if [[ ! -e "${project}/.firm/RESEARCH_PROGRAM.md" ]]; then
    cp "${ROOT_DIR}/templates/RESEARCH_PROGRAM.md" \
      "${project}/.firm/RESEARCH_PROGRAM.md"
    echo "Created .firm/RESEARCH_PROGRAM.md"
  else
    echo "Kept existing .firm/RESEARCH_PROGRAM.md"
  fi

  for template in FIRST_MESSAGE_NEW.md FIRST_MESSAGE_AUDIT.md; do
    if [[ ! -e "${project}/.firm/${template}" ]]; then
      cp "${ROOT_DIR}/templates/${template}" "${project}/.firm/${template}"
      echo "Created .firm/${template}"
    else
      echo "Kept existing .firm/${template}"
    fi
  done

  local claude_file="${project}/CLAUDE.md"
  local marker="<!-- FIRM:BEGIN -->"
  if [[ ! -e "${claude_file}" ]]; then
    {
      printf '# Project Instructions\n\n'
      cat "${ROOT_DIR}/templates/CLAUDE_FIRM_BLOCK.md"
    } > "${claude_file}"
    echo "Created CLAUDE.md with the FIRM block"
  elif grep -Fq "${marker}" "${claude_file}"; then
    echo "Kept existing FIRM block in CLAUDE.md"
  else
    local backup="${project}/.firm/CLAUDE.md.before-firm"
    if [[ ! -e "${backup}" ]]; then
      cp "${claude_file}" "${backup}"
    fi
    {
      printf '\n\n'
      cat "${ROOT_DIR}/templates/CLAUDE_FIRM_BLOCK.md"
    } >> "${claude_file}"
    echo "Added the FIRM block to CLAUDE.md"
    echo "Preserved the original at .firm/CLAUDE.md.before-firm"
  fi

  echo
  echo "FIRM is attached to:"
  echo "  ${project}"
  echo
  echo "Next:"
  echo "  1. Review .firm/RESEARCH_PROGRAM.md"
  echo "  2. Run: cd \"${project}\" && claude"
  echo "  3. Invoke /research-pipeline, or use one of the first-message templates"
}

doctor_project() {
  local requested="${1:-$PWD}"
  if [[ ! -d "${requested}" ]]; then
    echo "error: project directory not found: ${requested}" >&2
    exit 2
  fi

  local project
  project="$(cd "${requested}" && pwd)"
  local failures=0

  if ! bash "${ROOT_DIR}/scripts/verify-install.sh" \
    "${project}/.claude/skills"; then
    failures=$((failures + 1))
  fi

  for required in \
    "${project}/CLAUDE.md" \
    "${project}/.firm/RESEARCH_PROGRAM.md" \
    "${project}/.firm/FIRST_MESSAGE_NEW.md" \
    "${project}/.firm/FIRST_MESSAGE_AUDIT.md"; do
    if [[ ! -s "${required}" ]]; then
      echo "MISSING project file: ${required}" >&2
      failures=$((failures + 1))
    fi
  done

  if command -v claude >/dev/null 2>&1; then
    echo "Claude Code: found"
  else
    echo "Claude Code: not found in PATH (installation files are still valid)"
  fi

  if [[ ${failures} -ne 0 ]]; then
    echo "FIRM doctor found ${failures} blocking issue(s)." >&2
    exit 1
  fi

  echo "FIRM doctor passed."
}

list_skills() {
  find "${ROOT_DIR}/skills" -mindepth 2 -maxdepth 2 -name SKILL.md -print \
    | sed -E 's#^.*/skills/([^/]+)/SKILL.md$#/\1#' \
    | sort
}

print_prompt() {
  case "${1:-}" in
    new)
      cat "${ROOT_DIR}/templates/FIRST_MESSAGE_NEW.md"
      ;;
    audit)
      cat "${ROOT_DIR}/templates/FIRST_MESSAGE_AUDIT.md"
      ;;
    *)
      echo "error: prompt requires new or audit" >&2
      exit 2
      ;;
  esac
}

case "${1:-help}" in
  init)
    init_project "${2:-$PWD}"
    ;;
  doctor)
    doctor_project "${2:-$PWD}"
    ;;
  list)
    list_skills
    ;;
  prompt)
    print_prompt "${2:-}"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "error: unknown command: $1" >&2
    usage >&2
    exit 2
    ;;
esac
